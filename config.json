            {
              "name": "consultar_disponibilidad",
              "description": "Consulta Google Calendar y devuelve horarios disponibles para una fecha. Usala cuando el cliente pregunte por horarios disponibles o antes de agendar. Parametros: fecha (YYYY-MM-DD), servicio (opcional).",
              "http_request": {
                "url": "https://n8n-k4xc.srv1444305.hstgr.cloud/webhook/clienteA/calendar",
                "method": "POST",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "action": "disponibilidad"
                },
                "include_arguments": true
              }
            },
            {
              "name": "agendar_cita",
              "description": "Crea una reunion en Google Calendar. Usala cuando el cliente confirme un horario especifico. Parametros obligatorios: nombre, fecha (YYYY-MM-DD), hora (HH:MM), telefono, email. Opcionales: servicio, notas.",
              "http_request": {
                "url": "https://n8n-k4xc.srv1444305.hstgr.cloud/webhook/clienteA/calendar",
                "method": "POST",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "action": "agendar"
                },
                "include_arguments": true
              }
            },
            {
              "name": "mover_reunion",
              "description": "Mueve una reunion existente en Google Calendar a nueva fecha/hora. Usala cuando el cliente quiera reprogramar su cita. Parametros: email del cliente, nueva_fecha (YYYY-MM-DD), nueva_hora (HH:MM).",
              "http_request": {
                "url": "https://n8n-k4xc.srv1444305.hstgr.cloud/webhook/clienteA/calendar",
                "method": "POST",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "action": "mover"
                },
                "include_arguments": true
              }
            },
            {
              "name": "eliminar_reunion",
              "description": "Cancela y elimina una reunion de Google Calendar. Usala cuando el cliente quiera cancelar su cita. Parametros: email del cliente, motivo (opcional).",
              "http_request": {
                "url": "https://n8n-k4xc.srv1444305.hstgr.cloud/webhook/clienteA/calendar",
                "method": "POST",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "action": "eliminar"
                },
                "include_arguments": true
              }
            },
            {
              "name": "enviar_cotizacion",
              "description": "Genera y envia una cotizacion formal al cliente. Usala cuando el cliente pida precios, una propuesta o cotizacion. Parametros: nombre, email, telefono, servicio, descripcion, presupuesto.",
